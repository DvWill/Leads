# Aplicação
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
TRUST_PROXY=false

# PostgreSQL local (docker-compose.yml)
POSTGRES_DB=prospecta
POSTGRES_USER=prospecta
POSTGRES_PASSWORD=prospecta_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prospecta:prospecta_dev@localhost:5432/prospecta?schema=public

# Sessões e proteção contra força bruta
SESSION_TTL_SECONDS=43200
MAX_FAILED_LOGINS=6
LOGIN_LOCK_SECONDS=900

# Seed local. Em produção, ambas as senhas são obrigatórias e não há fallback.
DEMO_ADMIN_EMAIL=admin@prospecta.local
DEMO_ADMIN_PASSWORD=Admin@Prospecta123!
DEMO_COLLABORATOR_EMAIL=colaborador@prospecta.local
DEMO_COLLABORATOR_PASSWORD=Colab@Prospecta123!
DEMO_ARTHUR_EMAIL=arthur@prospecta.local
DEMO_ARTHUR_PASSWORD=Arthur@Prospecta123!
DEMO_ANA_EMAIL=ana@prospecta.local
DEMO_ANA_PASSWORD=Ana@Prospecta123!
# Defina true apenas quando desejar redefinir senhas de usuários demo existentes.
SEED_RESET_PASSWORDS=false

# Importação
MAX_CSV_UPLOAD_BYTES=10485760
CSV_IMPORT_BATCH_SIZE=200

