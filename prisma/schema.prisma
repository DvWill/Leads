model ImportJob {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                   @map("organization_id") @db.Uuid
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdById        String                   @map("created_by_id") @db.Uuid
  createdBy          User                     @relation("ImportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  filename           String                   @db.VarChar(255)
  mimeType           String                   @map("mime_type") @db.VarChar(120)
  fileSizeBytes      Int                      @map("file_size_bytes")
  fileSha256         String?                  @map("file_sha256") @db.Char(64)
  encoding           String                   @default("utf-8") @db.VarChar(32)
  delimiter          String                   @default(",") @db.Char(1)
  hasHeader          Boolean                  @default(true) @map("has_header")
  columnMapping      Json                     @default("{}") @map("column_mapping")
  duplicateStrategy  DuplicateStrategy        @default(SKIP) @map("duplicate_strategy")
  assignmentStrategy ImportAssignmentStrategy @default(UNASSIGNED) @map("assignment_strategy")
  assignmentConfig   Json                     @default("{}") @map("assignment_config")
  status             ImportStatus             @default(PENDING)
  totalRows          Int                      @default(0) @map("total_rows")
  processedRows      Int                      @default(0) @map("processed_rows")
  createdRows        Int                      @default(0) @map("created_rows")
  updatedRows        Int                      @default(0) @map("updated_rows")
  skippedRows        Int                      @default(0) @map("skipped_rows")
  errorRows          Int                      @default(0) @map("error_rows")
  startedAt          DateTime?                @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz(3)
  failureMessage     String?                  @map("failure_message") @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  rows               ImportJobRow[]
  leads              Lead[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("import_jobs")
}

model ImportJobRow {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importJobId     String          @map("import_job_id") @db.Uuid
  importJob       ImportJob       @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber       Int             @map("row_number")
  status          ImportRowStatus @default(PENDING)
  rawData         Json            @map("raw_data")
  normalizedData  Json?           @map("normalized_data")
  errors          Json            @default("[]")
  leadId          String?         @map("lead_id") @db.Uuid
  lead            Lead?           @relation("ImportRowLead", fields: [leadId], references: [id], onDelete: SetNull)
  duplicateLeadId String?         @map("duplicate_lead_id") @db.Uuid
  duplicateLead   Lead?           @relation("ImportRowDuplicateLead", fields: [duplicateLeadId], references: [id], onDelete: SetNull)
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([importJobId, rowNumber])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([duplicateLeadId])
  @@map("import_job_rows")
}

model AuditLog {
